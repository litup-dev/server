generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Club {
  id                   Int                       @id @default(autoincrement())
  userId               Int                       @map("user_id")
  createdAt            DateTime?                 @default(now()) @map("created_at") @db.Timestamptz(6)
  name                 String?                   @db.VarChar(20)
  location             Unsupported("geography")?
  phone                String?                   @db.VarChar(15)
  openTime             DateTime?                 @map("open_time") @db.Time(6)
  closeTime            DateTime?                 @map("close_time") @db.Time(6)
  capacity             Int?
  address              String?                   @db.VarChar(50)
  description          String?
  avgRating            Float?                    @default(0.0) @map("avg_rating")
  reviewCnt            Int?                      @default(0) @map("review_cnt")
  updated_at           DateTime?                 @db.Timestamptz(6)
  sns_links            Json?
  latestReviewAt       DateTime?                 @map("latest_review_at") @db.Timestamptz(6)
  longitude            Float?
  latitude             Float?
  detail_address       String?                   @db.VarChar(100)
  instagram_account    String?                   @db.VarChar(50)
  use_yn               Boolean?                  @default(true)
  club_img_tb          club_img_tb[]
  club_keyword_summary club_keyword_summary[]
  club_review_tb       club_review_tb[]
  user_tb              user_tb                   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  favorite_tb          favorite_tb[]
  perform_tb           Perform[]
  perform_tmp          perform_tmp[]

  @@index([avgRating(sort: Desc), createdAt(sort: Desc), id(sort: Desc)], map: "club_tb_avg_rating_created_at_id_index")
  @@index([avgRating, createdAt, id], map: "club_tb_avg_rating_created_at_id_index_desc")
  @@index([id], map: "club_tb_id_index")
  @@index([latestReviewAt, createdAt, id], map: "club_tb_latest_review_at_created_at_id_index")
  @@index([latestReviewAt(sort: Desc), createdAt(sort: Desc), id(sort: Desc)], map: "club_tb_latest_review_at_created_at_id_index_desc")
  @@index([reviewCnt, createdAt, id], map: "club_tb_review_cnt_created_at_id_index")
  @@index([reviewCnt(sort: Desc), createdAt(sort: Desc), id(sort: Desc)], map: "club_tb_review_cnt_created_at_id_index_desc")
  @@map("club_tb")
}

model attend_tb {
  perform_id Int
  user_id    Int
  created_at DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  perform_tb Perform   @relation(fields: [perform_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_tb    user_tb   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([perform_id, user_id])
}

model club_img_tb {
  id            Int       @id @default(autoincrement())
  club_id       Int
  user_id       Int
  file_path     String?   @db.VarChar(255)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @db.Timestamptz(6)
  is_main       Boolean?
  file_size     BigInt?
  original_name String?   @db.VarChar(255)
  club_tb       Club      @relation(fields: [club_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_tb       user_tb   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model club_keyword_summary {
  id             Int            @id @default(autoincrement())
  club_id        Int
  keyword_id     Int
  review_id      Int
  club_tb        Club           @relation(fields: [club_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  club_review_tb club_review_tb @relation(fields: [review_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "club_keyword_summary_club_review_id_fkey")
  keyword_tb     keyword_tb     @relation(fields: [keyword_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model club_review_keyword_tb {
  id             Int            @id @default(autoincrement())
  keyword_id     Int
  review_id      Int
  keyword_tb     keyword_tb     @relation(fields: [keyword_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  club_review_tb club_review_tb @relation(fields: [review_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model club_review_tb {
  id                     Int                      @id @default(autoincrement())
  club_id                Int
  user_id                Int
  rating                 Float?
  created_at             DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?                @db.Timestamptz(6)
  content                String?
  club_keyword_summary   club_keyword_summary[]
  club_review_keyword_tb club_review_keyword_tb[]
  club_tb                Club                     @relation(fields: [club_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_tb                user_tb                  @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  review_img_tb          review_img_tb[]

  @@index([created_at, id], map: "club_review_tb_created_at_id_index")
  @@index([created_at(sort: Desc), id(sort: Desc)], map: "club_review_tb_created_at_id_index_desc")
}

model favorite_tb {
  id      Int     @id @default(autoincrement())
  club_id Int
  user_id Int
  club_tb Club    @relation(fields: [club_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_tb user_tb @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model keyword_category_code {
  id         Int          @id @default(autoincrement())
  code       String?      @db.VarChar(10)
  name       String?      @db.VarChar(10)
  keyword_tb keyword_tb[]
}

model keyword_tb {
  id                     Int                      @id @default(autoincrement())
  category_id            Int
  name                   String?                  @db.VarChar(50)
  icon_path              String?
  sort_order             Int?
  club_keyword_summary   club_keyword_summary[]
  club_review_keyword_tb club_review_keyword_tb[]
  keyword_category_code  keyword_category_code    @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model perform_img_tb {
  id            Int       @id @default(autoincrement())
  perform_id    Int
  file_path     String?   @db.VarChar(255)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @db.Timestamptz(6)
  is_main       Boolean?
  original_name String?   @db.VarChar(255)
  file_size     BigInt?
  perform_tb    Perform   @relation(fields: [perform_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model perform_review_tb {
  id                     Int                      @id @default(autoincrement())
  perform_id             Int
  user_id                Int
  created_at             DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?                @db.Timestamptz(6)
  content                String                   @db.VarChar(100)
  like_count             Int                      @default(0)
  perform_review_like_tb perform_review_like_tb[]
  perform_tb             Perform                  @relation(fields: [perform_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_tb                user_tb                  @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([perform_id, user_id], map: "uk_perform_review_user_perform")
  @@index([created_at, id], map: "perform_review_tb_created_at_id_index")
  @@index([created_at(sort: Desc), id(sort: Desc)], map: "perform_review_tb_created_at_id_index_desc")
}

model Perform {
  id                Int                 @id @default(autoincrement())
  club_id           Int
  user_id           Int
  title             String?             @db.VarChar(100)
  description       String?
  perform_date      DateTime?           @db.Timestamptz(6)
  booking_price     Int?                @default(0)
  created_at        DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?           @db.Timestamptz(6)
  is_cancelled      Boolean?
  artists           Json?
  sns_links         Json?
  onsite_price      Int?                @default(0)
  booking_url       String?             @db.VarChar(255)
  is_deleted        Boolean?
  attend_tb         attend_tb[]
  perform_img_tb    perform_img_tb[]
  perform_review_tb perform_review_tb[]
  club_tb           Club                @relation(fields: [club_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_tb           user_tb             @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([perform_date, id], map: "perform_date_id_index")
  @@index([perform_date(sort: Desc), id(sort: Desc)], map: "perform_date_id_index_desc")
  @@map("perform_tb")
}

model report_category_code {
  id        Int         @id @default(autoincrement())
  code      String?     @db.VarChar(50)
  name      String?     @db.VarChar(50)
  report_tb report_tb[]
}

model report_status_code {
  id        Int         @id @default(autoincrement())
  code      String?     @db.VarChar(20)
  name      String?     @db.VarChar(10)
  report_tb report_tb[]
}

model report_tb {
  id                   Int                  @id @default(autoincrement())
  user_id              Int
  category_id          Int
  type_id              Int
  status_id            Int
  entity_id            Int
  created_at           DateTime?            @default(now()) @db.Timestamptz(6)
  content              String?
  report_category_code report_category_code @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  report_status_code   report_status_code   @relation(fields: [status_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  report_type_code     report_type_code     @relation(fields: [type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_tb              user_tb              @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model report_type_code {
  id        Int         @id @default(autoincrement())
  code      String?     @db.VarChar(20)
  name      String?     @db.VarChar(10)
  report_tb report_tb[]
}

model review_img_tb {
  id             Int            @id @default(autoincrement())
  review_id      Int
  file_path      String?        @db.VarChar(255)
  created_at     DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?      @db.Timestamptz(6)
  is_main        Boolean?
  original_name  String?        @db.VarChar(255)
  file_size      BigInt?
  club_review_tb club_review_tb @relation(fields: [review_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model social_code {
  id      Int       @id @default(autoincrement())
  code    String?   @db.VarChar(10)
  name    String?   @db.VarChar(20)
  user_tb user_tb[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

model user_tb {
  id                     Int                      @id @default(autoincrement())
  social_id              Int
  nickname               String?                  @db.VarChar(23)
  created_at             DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?                @db.Timestamptz(6)
  profile_path           String?
  role                   String?                  @default("user") @db.VarChar(20)
  provider_id            String?                  @db.VarChar(255)
  bio                    String?
  email                  String?                  @db.VarChar(255)
  public_id              String                   @default("0") @db.VarChar(13)
  attend_tb              attend_tb[]
  club_img_tb            club_img_tb[]
  club_review_tb         club_review_tb[]
  club_tb                Club[]
  favorite_tb            favorite_tb[]
  notice_tb              notice_tb[]
  perform_review_like_tb perform_review_like_tb[]
  perform_review_tb      perform_review_tb[]
  perform_tb             Perform[]
  perform_tmp            perform_tmp[]
  post_comment_tb        post_comment_tb[]
  post_img_tb            post_img_tb[]
  post_like_tb           post_like_tb[]
  post_tb                post_tb[]
  report_tb              report_tb[]
  user_settings_tb       user_settings_tb?
  social_code            social_code              @relation(fields: [social_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([social_id, provider_id], map: "uq_user_tb_socialid_providerid")
  @@index([public_id], map: "uq_user_tb_public_id")
}

model perform_review_like_tb {
  id                Int               @id @default(autoincrement())
  review_id         Int
  user_id           Int
  created_at        DateTime?         @default(now()) @db.Timestamptz(6)
  perform_review_tb perform_review_tb @relation(fields: [review_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_tb           user_tb           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([review_id, user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model user_settings_tb {
  user_id                 Int      @id
  favorite_clubs_privacy  String   @default("public") @db.VarChar(20)
  attendance_privacy      String   @default("public") @db.VarChar(20)
  perform_history_privacy String   @default("public") @db.VarChar(20)
  created_at              DateTime @default(now()) @db.Timestamptz(6)
  updated_at              DateTime @default(now()) @db.Timestamptz(6)
  user_tb                 user_tb  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_settings_user")

  @@index([attendance_privacy], map: "idx_user_settings_attendance_privacy")
  @@index([favorite_clubs_privacy], map: "idx_user_settings_favorite_privacy")
  @@index([perform_history_privacy], map: "idx_user_settings_perform_history_privacy")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model nickname_word_tb {
  id       Int    @id @default(autoincrement())
  category String @db.VarChar(10)
  word     String @db.VarChar(10)

  @@index([category], map: "idx_category")
}

model perform_img_tmp {
  id            Int         @id @default(autoincrement())
  perform_id    Int
  file_path     String?     @db.VarChar(255)
  created_at    DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?   @db.Timestamptz(6)
  is_main       Boolean?
  original_name String?     @db.VarChar(255)
  file_size     BigInt?
  perform_tmp   perform_tmp @relation(fields: [perform_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model perform_tmp {
  id                  Int               @id @default(autoincrement())
  club_id             Int
  user_id             Int
  title               String?           @db.VarChar(100)
  description         String?
  perform_date        DateTime?         @db.Timestamptz(6)
  booking_price       Int?              @default(0)
  created_at          DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?         @db.Timestamptz(6)
  is_cancelled        Boolean?
  artists             Json?
  sns_links           Json?
  onsite_price        Int?              @default(0)
  booking_url         String?           @db.VarChar(255)
  instagram_shortcode String?           @unique @db.VarChar(100)
  status              Boolean?          @default(false)
  perform_img_tmp     perform_img_tmp[]
  club_tb             Club              @relation(fields: [club_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_tb             user_tb           @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model notice_tb {
  id         Int       @id @default(autoincrement())
  user_id    Int
  title      String    @db.VarChar(200)
  content    String
  is_popup   Boolean   @default(false)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @db.Timestamptz(6)
  user_tb    user_tb   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at(sort: Desc), id(sort: Desc)], map: "notice_tb_created_at_id_index_desc")
  @@index([is_popup, created_at(sort: Desc)], map: "notice_tb_is_popup_created_at_index")
}

model board_tb {
  id         Int       @id @default(autoincrement())
  code       String    @unique @db.VarChar(30)
  name       String    @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  post_tb    post_tb[]
}

model post_category_code {
  id      Int       @id @default(autoincrement())
  code    String    @unique @db.VarChar(30)
  name    String    @db.VarChar(50)
  post_tb post_tb[]
}

model post_comment_tb {
  id                    Int               @id @default(autoincrement())
  post_id               Int
  user_id               Int
  parent_id             Int?
  content               String
  created_at            DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?         @db.Timestamptz(6)
  is_deleted            Boolean           @default(false)
  post_comment_tb       post_comment_tb?  @relation("post_comment_tbTopost_comment_tb", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_post_comment_tb post_comment_tb[] @relation("post_comment_tbTopost_comment_tb")
  post_tb               post_tb           @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_tb               user_tb           @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([post_id, created_at], map: "post_comment_tb_post_idx")
}

model post_img_tb {
  id            Int       @id @default(autoincrement())
  post_id       Int?
  user_id       Int
  file_path     String    @db.VarChar(255)
  original_name String?   @db.VarChar(255)
  file_size     BigInt?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  post_tb       post_tb?  @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_tb       user_tb   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([post_id], map: "post_img_tb_post_idx")
}

model post_like_tb {
  id         Int       @id @default(autoincrement())
  post_id    Int
  user_id    Int
  like_type  String    @db.VarChar(10)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  post_tb    post_tb   @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_tb    user_tb   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([post_id, user_id], map: "uq_post_like_tb_post_user")
}

model post_tb {
  id                 Int                 @id @default(autoincrement())
  board_id           Int
  user_id            Int
  category_id        Int?
  title              String              @db.VarChar(50)
  content            String
  created_at         DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?           @db.Timestamptz(6)
  post_comment_tb    post_comment_tb[]
  post_img_tb        post_img_tb[]
  post_like_tb       post_like_tb[]
  board_tb           board_tb            @relation(fields: [board_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  post_category_code post_category_code? @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_tb            user_tb             @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([board_id, created_at(sort: Desc), id(sort: Desc)], map: "post_tb_board_created_idx")
  @@index([user_id], map: "post_tb_user_idx")
}
